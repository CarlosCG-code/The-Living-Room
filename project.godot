config_version=5

[application]
config/name="The Living Room"
run/main_scene="res://presentation/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
DevBoot="*res://autoload/dev_boot.gd"
EventBus="*res://autoload/event_bus.gd"
Game="*res://autoload/game.gd"
GameClock="*res://autoload/game_clock.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080

[internationalization]
locale/translations=PackedStringArray("res://locale/strings.es.translation")
locale/fallback="es"

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3
occlusion_culling/use_occlusion_culling=true
reflections/reflection_atlas/reflection_count=4

[importer_defaults]

texture={
"compress/high_quality": true,
"compress/mode": 2,
"mipmaps/generate": true
}

