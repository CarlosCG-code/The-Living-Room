cost_growth = 1.15
threshold = 16846002.0
base_click_value = 1.0
events = Array[ExtResource("evt_script")]([SubResource("evt_interference"), SubResource("evt_shooting_star"), SubResource("evt_clear_signal"), SubResource("evt_silhouette")])
perks = Array[ExtResource("perk_script")]([SubResource("perk_hands"), SubResource("perk_memory"), SubResource("perk_habit"), SubResource("perk_pulse"), SubResource("perk_name")])
event_min = 120.0
event_max = 240.0
