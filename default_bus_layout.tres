[gd_resource type="AudioBusLayout" load_steps=6 format=3]

[sub_resource type="AudioEffectHighPassFilter" id="tv_hp"]
resource_name = "HighPassFilter"
cutoff_hz = 140.0

[sub_resource type="AudioEffectLowPassFilter" id="tv_lp"]
resource_name = "LowPassFilter"
cutoff_hz = 8000.0

[sub_resource type="AudioEffectLowPassFilter" id="tv_occlusion_lp"]
resource_name = "OcclusionLowPass"
cutoff_hz = 20000.0

[sub_resource type="AudioEffectAmplify" id="tv_occlusion_gain"]
resource_name = "OcclusionGain"

[sub_resource type="AudioEffectReverb" id="room_reverb"]
resource_name = "Reverb"
room_size = 0.28
damping = 0.7
spread = 0.7
hipass = 0.15
dry = 0.0
wet = 0.5

[resource]
bus/1/name = &"TV"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/1/effect/0/effect = SubResource("tv_hp")
bus/1/effect/0/enabled = true
bus/1/effect/1/effect = SubResource("tv_lp")
bus/1/effect/1/enabled = true
bus/1/effect/2/effect = SubResource("tv_occlusion_lp")
bus/1/effect/2/enabled = true
bus/1/effect/3/effect = SubResource("tv_occlusion_gain")
bus/1/effect/3/enabled = true
bus/2/name = &"Room"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/2/effect/0/effect = SubResource("room_reverb")
bus/2/effect/0/enabled = true
bus/3/name = &"House"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"Master"
